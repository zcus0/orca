{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": { "csp": null },
    "windows": [
      {
        "center": true,
        "height": 900,
        "label": "main",
        "minHeight": 600,
        "minWidth": 900,
        "title": "Orca RS",
        "url": "https://orca.zcus.dev",
        "width": 1440
      }
    ]
  },
  "build": { "frontendDist": "../web-placeholder" },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "longDescription": "A lightweight Tauri (Rust + system webview) shell that loads the Orca web client. Sessions run on the remote Orca server; this app replaces the Electron desktop shell for remote work.",
    "shortDescription": "Orca RS - Tauri shell for the Orca web client",
    "targets": "all",
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper" } }
  },
  "identifier": "dev.zcus.orca.rs",
  "productName": "Orca RS",
  "version": "0.1.0"
}
